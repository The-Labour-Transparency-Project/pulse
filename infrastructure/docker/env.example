#
# copy this file to .env to be picked up by docker-compose
#
# see https://github.com/novuhq/novu/pkgs/container/novu%2Fapi to find version
IMAGE_VERSION=

# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
JWT_SECRET=<Must be 128 bits (16 chars)>>
STORE_ENCRYPTION_KEY=<ENCRYPTION_KEY_MUST_BE_32_LONG>

# PICMI
API_CLIENT_DOMAIN=http://localhost:8050/
API_DOMAIN=http://localhost:5000/
APP_DOMAIN=http://localhost:8080/

# AWS
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

LOCAL_STACK=http://localhost:14566

# S3_URL=http://localhost:4566 # localstack
# S3_URL=http://localhost:9000 # minio
S3_URL=http://localhost:19000
S3_BUCKET_NAME=local-pulse
S3_REGION=ap-southeast-2
PULSE_RESPONDENT_ORIGIN=http://localhost:5173
