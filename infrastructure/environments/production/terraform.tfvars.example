aws_region          = "ap-southeast-2"
bucket_name         = "ltp-pulse-results"
lambda_artifact_path = "../../../apps/pulse-api/artifacts/pulse-api.zip"
respondent_base_url = "https://survey.labourtransparency.com"
ses_sender          = "no-reply@labourtransparency.com"
cors_allow_origins  = ["https://survey.labourtransparency.com"]
